PORT=4000
# Set to 'production' in hosted environment to enable security guards
# (fail-closed webhook, no demo mode, stack trace suppression)
NODE_ENV=development

# Allowed CORS origin for the frontend (e.g. https://yourdomain.vercel.app)
# If omitted in production, CORS is disabled. In development, defaults to *.
# FRONTEND_ORIGIN=https://yourdomain.vercel.app

# Prefer base64 in hosted envs (Vercel): encode your serviceAccount.json and paste here
# GOOGLE_SERVICE_ACCOUNT_BASE64=base64_of_service_account_json

# For local dev you can point to the JSON file path instead:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
# Secret untuk validasi webhook dari Telegram (opsional tapi sangat disarankan).
# Set via BotFather: panggil /setwebhook dengan parameter secret_token.
# Contoh curl:
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://yourapp.vercel.app/api/telegram-webhook" \
#     -d "secret_token=YOUR_RANDOM_SECRET"
TELEGRAM_WEBHOOK_SECRET=

# Secret for /api/cron/reminders endpoint. Falls back to TELEGRAM_WEBHOOK_SECRET if unset.
# Must be configured for the cron endpoint to accept requests.
# CRON_SECRET=your_random_cron_secret

# Google Gemini API Keys (satu atau banyak dipisah koma untuk auto-rotasi Free Tier)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
# Whitelist Telegram Chat IDs untuk developer test command (/teststreak, /testkartu). Dipisah koma.
DEV_TELEGRAM_IDS=123456789,987654321

# SMTP configuration for branded verification email template (#e45153 & Poppins)
# If omitted, system falls back to Firebase Client SDK default verification email.
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_google_app_password
# SMTP_FROM="Pocketplan <your_email@gmail.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pocketplan <noreply@pocketplan.my.id>"



